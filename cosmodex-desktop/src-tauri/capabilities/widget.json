{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Observation log widget window: event bridge to the main window, drag, and self-close",
  "windows": ["obs-chart"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
